<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ t.t("report_title") }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
         max-width: 880px; margin: 2rem auto; padding: 0 1rem; color: #222; line-height: 1.5; }
  h1 { margin-bottom: 0.25rem; }
  h2 { margin-top: 2.4rem; border-bottom: 1px solid #ddd; padding-bottom: 0.2rem; }
  .grid-strip {
    display: flex; gap: 1px; padding: 0.4rem 0;
    flex-wrap: nowrap; overflow-x: auto;
  }
  .grid-cell {
    flex: 1 0 4px; min-width: 3px; height: 28px;
    border-radius: 1.5px;
  }
  .grid-cell.sev-none    { background: #2ea043; }
  .grid-cell.sev-flicker { background: #d4a72c; }
  .grid-cell.sev-minor   { background: #db8c2a; }
  .grid-cell.sev-major   { background: #e5534b; }
  .grid-cell.sev-severe  { background: #8b1f1f; }
  .grid-cell.sev-no_data { background: #d0d7de; }
  .grid-axis { display: flex; justify-content: space-between;
               color: #888; font-size: 0.78rem; margin-top: 0.2rem;
               font-variant-numeric: tabular-nums; }
  .legend { display: flex; gap: 0.9rem; flex-wrap: wrap;
            margin-top: 0.5rem; font-size: 0.82rem; color: #555; }
  .legend-swatch { display: inline-block; width: 0.7rem; height: 0.7rem;
                   border-radius: 1.5px; margin-right: 0.3rem; vertical-align: middle; }
  .legend-swatch.sev-none    { background: #2ea043; }
  .legend-swatch.sev-flicker { background: #d4a72c; }
  .legend-swatch.sev-minor   { background: #db8c2a; }
  .legend-swatch.sev-major   { background: #e5534b; }
  .legend-swatch.sev-severe  { background: #8b1f1f; }
  .legend-swatch.sev-no_data { background: #d0d7de; }
  table { border-collapse: collapse; width: 100%; margin-top: 0.6rem; font-size: 0.92rem; }
  th, td { padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; text-align: left; }
  th { background: #fafafa; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1.6rem; margin-top: 0.8rem; }
  .summary-grid .k { color: #666; }
  .summary-grid .v { font-weight: 600; font-variant-numeric: tabular-nums; }
  footer { margin-top: 3rem; color: #888; font-size: 0.85rem; }
  .muted { color: #888; }

  /* Screen-only navigation. Hidden when printing. */
  .toolbar {
    display: flex; gap: 0.6rem; align-items: center;
    margin-bottom: 1.2rem; font-size: 0.88rem;
    padding-bottom: 0.6rem; border-bottom: 1px solid #eee;
  }
  .toolbar a {
    color: #0969da; text-decoration: none;
    padding: 0.2rem 0.55rem; border-radius: 6px;
    border: 1px solid transparent;
  }
  .toolbar a:hover { background: #f3f4f6; }
  .toolbar a.active {
    background: #0969da; color: #fff; border-color: #0969da; font-weight: 600;
  }
  .toolbar .sep { color: #ccc; }
  .toolbar .spacer { flex: 1; }
  .toolbar .hint { color: #888; font-size: 0.78rem; }

  @media print {
    .toolbar, .no-print { display: none !important; }
    body { margin: 0.5in; max-width: none; color: #000; }
    h2 { page-break-after: avoid; }
    table, .grid-strip { page-break-inside: avoid; }
    a { color: #000; text-decoration: none; }
  }
</style>
</head>
<body>
{% if show_toolbar %}
<nav class="toolbar">
  <a href="/">&larr; {{ t.t("toolbar_back") }}</a>
  <span class="sep">|</span>
  <span>{{ t.t("toolbar_window") }}:</span>
  {% for opt in window_options -%}
  <a href="?lang={{ lang }}&since={{ opt.spec }}"{% if opt.active %} class="active"{% endif %}>{{ opt.label }}</a>
  {% endfor %}
  <span class="sep">|</span>
  <span>{{ t.t("toolbar_language") }}:</span>
  <a href="?lang=en&since={{ since_spec }}"{% if lang == "en" %} class="active"{% endif %}>EN</a>
  <a href="?lang=de&since={{ since_spec }}"{% if lang == "de" %} class="active"{% endif %}>DE</a>
  <span class="spacer"></span>
  <span class="hint">{{ t.t("toolbar_print_hint") }}</span>
</nav>
{% endif %}

<h1>{{ t.t("report_title") }}</h1>
<p class="muted">{{ t.t("report_subtitle", owner=owner) }}</p>

<div class="summary-grid">
  <div class="k">{{ t.t("period") }}</div>
  <div class="v">{{ t.t("period_value", start=start_str, end=end_str, duration=duration_str) }}</div>
  <div class="k">{{ t.t("generated_at") }}</div>
  <div class="v">{{ generated_at_str }}</div>
</div>

<h2>{{ t.t("summary_heading") }}</h2>
<div class="summary-grid">
  <div class="k">{{ t.t("summary_uptime") }}</div>
  <div class="v">{{ "%.3f" % uptime_pct_value }} %</div>
  <div class="k">{{ t.t("summary_outage_count") }}</div>
  <div class="v">{{ outages|length }}</div>
  <div class="k">{{ t.t("summary_total_outage") }}</div>
  <div class="v">{{ total_outage_str }}</div>
  <div class="k">{{ t.t("summary_longest_outage") }}</div>
  <div class="v">{{ longest_outage_str }}</div>
  <div class="k">{{ t.t("summary_buffer_bloat") }}</div>
  <div class="v">{% if buffer_bloat is none %}—{% else %}{{ "%.1f" % buffer_bloat }} ms{% endif %}</div>
</div>

<h2>{{ t.t("grid_heading") }}</h2>
<p class="muted">{{ t.t("grid_intro") }}</p>
<div class="grid-strip">
{% for b in grid_buckets -%}
<div class="grid-cell sev-{{ b.severity }}" title="{{ b.start_str }} — {{ "%.2f" % b.uptime_pct }}% uptime{% if b.outage_count %}, {{ b.outage_count }} outage{% if b.outage_count != 1 %}s{% endif %}, longest {{ b.longest_outage_str }}{% endif %}"></div>
{%- endfor %}
</div>
<div class="grid-axis">{{ t.t("grid_axis", start=grid_start_str, end=grid_end_str) }}</div>
<div class="legend">
  <span><i class="legend-swatch sev-none"></i>{{ t.t("grid_legend_none") }}</span>
  <span><i class="legend-swatch sev-flicker"></i>{{ t.t("grid_legend_flicker") }}</span>
  <span><i class="legend-swatch sev-minor"></i>{{ t.t("grid_legend_minor") }}</span>
  <span><i class="legend-swatch sev-major"></i>{{ t.t("grid_legend_major") }}</span>
  <span><i class="legend-swatch sev-severe"></i>{{ t.t("grid_legend_severe") }}</span>
  <span><i class="legend-swatch sev-no_data"></i>{{ t.t("grid_legend_no_data") }}</span>
</div>

<h2>{{ t.t("methodology_heading") }}</h2>
<p>{{ t.t("methodology_body",
        icmp_interval=icmp_interval,
        icmp_target_count=icmp_target_count,
        tcp_interval=tcp_interval,
        mtr_interval_min=mtr_interval_min) }}</p>

<h2>{{ t.t("outages_heading") }}</h2>
{% if outages|length == 0 %}
  <p>{{ t.t("outages_none") }}</p>
{% else %}
  <table>
    <thead>
      <tr>
        <th>{{ t.t("outages_col_start") }}</th>
        <th class="num">{{ t.t("outages_col_duration") }}</th>
        <th class="num">{{ t.t("outages_col_failed_probes") }}</th>
        <th>{{ t.t("outages_col_targets") }}</th>
      </tr>
    </thead>
    <tbody>
    {% for o in outages %}
      <tr>
        <td>{{ o.start_str }}</td>
        <td class="num">{{ o.duration_str }}</td>
        <td class="num">{{ o.failed_probes }}</td>
        <td>{{ o.affected_targets|join(", ") }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endif %}

<h2>{{ t.t("latency_heading") }}</h2>
<table>
  <thead>
    <tr>
      <th>{{ t.t("latency_col_target") }}</th>
      <th class="num">{{ t.t("latency_col_samples") }}</th>
      <th class="num">{{ t.t("latency_col_success") }}</th>
      <th class="num">{{ t.t("latency_col_p50") }}</th>
      <th class="num">{{ t.t("latency_col_p95") }}</th>
      <th class="num">{{ t.t("latency_col_p99") }}</th>
      <th class="num">{{ t.t("latency_col_max") }}</th>
    </tr>
  </thead>
  <tbody>
  {% for s in latency %}
    <tr>
      <td>{{ s.label }} <span class="muted">({{ s.target }})</span></td>
      <td class="num">{{ s.samples }}</td>
      <td class="num">{{ "%.2f" % s.success_pct }}</td>
      <td class="num">{% if s.p50_ms is none %}—{% else %}{{ "%.1f" % s.p50_ms }}{% endif %}</td>
      <td class="num">{% if s.p95_ms is none %}—{% else %}{{ "%.1f" % s.p95_ms }}{% endif %}</td>
      <td class="num">{% if s.p99_ms is none %}—{% else %}{{ "%.1f" % s.p99_ms }}{% endif %}</td>
      <td class="num">{% if s.max_ms is none %}—{% else %}{{ "%.1f" % s.max_ms }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>{{ t.t("paths_heading") }}</h2>
{% if path_changes|length == 0 %}
  <p>{{ t.t("paths_none") }}</p>
{% else %}
  <table>
    <thead>
      <tr>
        <th>{{ t.t("paths_col_at") }}</th>
        <th>{{ t.t("paths_col_target") }}</th>
        <th class="num">{{ t.t("paths_col_hop") }}</th>
        <th>{{ t.t("paths_col_change") }}</th>
      </tr>
    </thead>
    <tbody>
    {% for c in path_changes %}
      <tr>
        <td>{{ c.at_str }}</td>
        <td>{{ c.target }}</td>
        <td class="num">{{ c.hop_idx }}</td>
        <td>{{ c.old_ip or "—" }} → {{ c.new_ip or "—" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endif %}

<footer>{{ t.t("footer", version=version) }}</footer>
</body>
</html>
